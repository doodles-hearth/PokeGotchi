const FLAG_REMOVE_TRASHCAN_INTERACTION = FLAG_TEMP_1
const FLAG_REMOVE_TREE_INTERACTION = FLAG_TEMP_2

mapscripts Tamatown_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if (flag(POKEGOTCHI_FLAG_VANILLISH_DIED)) {
			setobjectxyperm(LOCALID_VANILLISH, 33, 20)
			setobjectxyperm(LOCALID_CAR, 23, 20)
			setobjectmovementtype(LOCALID_VANILLISH, MOVEMENT_TYPE_FACE_UP)
		}
	}
}

script Tamatown_EventScript_Arcade {
	lock

	showcoinsbox(20, 0)

	msgbox(
		"Play {COLOR RED}Pachinko{COLOR DARK_GRAY}?\p"
	)

	mcdialogueB(
		"Play",
		"Don't play"
	)

	closemessage
	hidecoinsbox

	playbgm(MUS_TRICK_HOUSE, FALSE)
	delay(32)
	callnative(PlayPachinko)
	waitstate
	savebgm(MUS_DUMMY)
	fadedefaultbgm

	release
}

script Tamatown_EventScript_Porygon {
	lockall

	if (flag(FLAG_EXPLAINED_PACHINKO)) {
		playse(SE_LEDGE)
		applymovement(VAR_LAST_TALKED, moves(jump_in_place_down))

		playmoncry(SPECIES_PORYGON, CRY_MODE_NORMAL)

		setspeaker("Porygon")
		msgbox(
			"Yooo, my man's back!\nWanna play {COLOR RED}PACHINKO{COLOR DARK_GRAY}??\p"
		)
	} else {
		setflag(FLAG_EXPLAINED_PACHINKO)

		playmoncry(SPECIES_PORYGON, CRY_MODE_NORMAL)
		setspeaker("Porygon")
		msgbox(
			"Yo, my man, come over here…\p"
			"Wanna try your luck at the most fun\nway to lose money ever invented?\l"
			"That's right, {COLOR RED}PACHINKO{COLOR DARK_GRAY}!!\p"
			"A game costs 3 coins.\nI'll give you 15 coins everyday!\p"
			"What are the coins for? Uhh…\nThey look super neat!"
		)
		closemessage
	}

	if (!flag(FLAG_RECEIVED_PACHINKO_COINS)) {
		message(
			"You got 15 coins!"
		)
		playfanfare(MUS_OBTAIN_ITEM)
		waitfanfare

		addcoins(15)

		closemessage

		setflag(FLAG_RECEIVED_PACHINKO_COINS)
	}

	mcdialogueB(
		"I wanna play!",
		"Nah."
	)	

	switch(var(VAR_RESULT)) {
		case 0:
			playmoncry(SPECIES_PORYGON, CRY_MODE_HIGH_PITCH)
			setspeaker("Porygon")
			msgbox(
				"Heck yeah! Have fun!"
			)
			closemessage

			switch (var(VAR_FACING)) {
				case DIR_NORTH:
					applymovement(LOCALID_PLAYER, moves(walk_right, face_up))
				case DIR_SOUTH:
					applymovement(LOCALID_PLAYER, moves(walk_left, walk_down * 2, walk_right * 2, face_up))
				case DIR_EAST:
					applymovement(LOCALID_PLAYER, moves(walk_down, walk_right * 2, face_up))
			}

			waitmovement(0)

			playbgm(MUS_TRICK_HOUSE, FALSE)
			delay(32)
			callnative(PlayPachinko)
			waitstate
			savebgm(MUS_DUMMY)
			fadedefaultbgm
			releaseall
			end
		default:
			playmoncry(SPECIES_PORYGON, CRY_MODE_WEAK)
			setspeaker("Porygon")
			msgbox(
				"Aight, aight, can't help ya if you\nhate fun…"
			)
	}

	closemessage

	releaseall
}

script Tamatown_EventScript_Tree {
	msgbox(
		"It's a tree.\nIt kinda looks like your cousin Mark.",
		MSGBOX_AUTOCLOSE
	)
}

script Tamatown_EventScript_Tangela {
	lock

	if (flag(POKEGOTCHI_FLAG_FOUND_TANGELA)) {
		playmoncry(SPECIES_TANGELA, CRY_MODE_NORMAL)
		setspeaker("Tangela")
		msgbox(
			"Don't look at me!\nI am invisible!"
		)
		waitmoncry
	} else {
		msgbox(
			"It's a tree."
		)

		mcdialogue(
			"Yep",
			"Totes"
		)

		closemessage

		delay(24)

		playse(SE_FU_ZAKU)
		applymovement(VAR_LAST_TALKED, moves(shake_vertical))
		waitse
		waitmovement(0)

		msgbox(
			"The tree moved impatiently."
		)

		mcdialogue(
			"Hmm.",
			"Ahem."
		)

		closemessage

		delay(24)

		playse(SE_FU_ZAKU)
		applymovement(VAR_LAST_TALKED, moves(shake_vertical))
		waitse
		waitmovement(0)

		setspeaker("Tree")
		msgbox(
			"{FONT_SMALL}Hee hee hee hee…{FONT_NORMAL}"
		)

		mcdialogue(
			"Were you hiding?",
			"I can see you"
		)

		playse(SE_PIN)
		applymovement(VAR_LAST_TALKED, moves(emote_exclamation_mark, delay_16 * 6))
		waitmovement(0)
		waitse

		playmoncry(SPECIES_TANGELA, CRY_MODE_NORMAL)
		setspeaker("Tangela")
		msgbox(
			"What? Oh, man!\p"
			"I was trying out my new “hiding in\nplain sight” secret technique…\l"
			"But you saw right through me!\p"
			"You must be some kind of genius!"
		)
		waitmoncry

		setflag(POKEGOTCHI_FLAG_FOUND_TANGELA)
	}

	closemessage

	release
}

